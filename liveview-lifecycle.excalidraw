    {
      "id": "concept-1-text",
      "type": "text",
      "x": 430,
      "y": 210,
      "width": 420,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1234567916,
      "version": 1,
      "versionNonce": 1234567916,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709494800000,
      "link": null,
      "locked": false,
      "text": "connected?(socket)\nfalse = Static mount (HTTP)\ntrue = Live mount (WebSocket)\nUse to skip expensive ops in static phase",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 73,
      "containerId": "concept-1",
      "originalText": "connected?(socket)\nfalse = Static mount (HTTP)\ntrue = Live mount (WebSocket)\nUse to skip expensive ops in static phase",
      "lineHeight": 1.25
    },
    {
      "id": "concept-2",
      "type": "rectangle",
      "x": 420,
      "y": 340,
      "width": 440,
