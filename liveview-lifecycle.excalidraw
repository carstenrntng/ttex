    {
      "id": "concept-2-text",
      "type": "text",
      "x": 500,
      "y": 910,
      "width": 310,
      "height": 120,
      "strokeColor": "#1e1e1e",
      "text": "✅ Use connected?(socket)\nfalse = static (skip expensive work)\ntrue = live (full setup)\n\nPattern:\nif connected?(socket) do\n  # subscribe, start timers\nend",
      "fontSize": 16,
      "fontFamily": "Virgil",
      "createdAt": "2026-03-03T20:14:26.688Z",
      "updatedAt": "2026-03-03T20:14:26.688Z",
      "version": 2,
      "versionNonce": 1499345844,
      "index": "ap",
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "backgroundColor": "transparent",
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1772569275579,
      "link": null,
      "locked": false,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "✅ Use connected?(socket)\nfalse = static (skip expensive work)\ntrue = live (full setup)\n\nPattern:\nif connected?(socket) do\n  # subscribe, start timers\nend",
      "autoResize": true,
      "lineHeight": 0.9375
    },
    {
      "id": "concept-3",
      "type": "rectangle",
      "x": 860,
