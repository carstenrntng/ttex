    {
      "id": "concept-1-text",
      "type": "text",
      "x": 120,
      "y": 910,
      "width": 310,
      "height": 120,
      "strokeColor": "#1e1e1e",
      "text": "✅ mount → handle_params → render\nRuns TWICE (static + live)\n\n⚠️ handle_params runs EVERY time:\n- After both mounts\n- On push_patch/navigate\n- Not optional!",
      "fontSize": 16,
      "fontFamily": "Virgil",
      "createdAt": "2026-03-03T20:14:26.688Z",
      "updatedAt": "2026-03-03T20:14:26.688Z",
      "version": 2,
      "versionNonce": 2137496116,
      "index": "an",
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "backgroundColor": "transparent",
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1772569275579,
      "link": null,
      "locked": false,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "✅ mount → handle_params → render\nRuns TWICE (static + live)\n\n⚠️ handle_params runs EVERY time:\n- After both mounts\n- On push_patch/navigate\n- Not optional!",
      "autoResize": true,
      "lineHeight": 1.0714285714285714
    },
    {
      "id": "concept-2",
      "type": "rectangle",
      "x": 480,
      "y": 890,
      "width": 350,
      "height": 160,
      "backgroundColor": "#ffffff",
      "strokeColor": "#9c36b5",
      "strokeWidth": 2,
      "fillStyle": "solid",
