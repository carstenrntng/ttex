      "link": null,
      "locked": false
    },
    {
      "id": "concept-3-text",
      "type": "text",
      "x": 430,
      "y": 535,
      "width": 420,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1234567920,
      "version": 1,
      "versionNonce": 1234567920,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709494800000,
      "link": null,
      "locked": false,
      "text": "handle_params/3\nRuns after mount AND on URL changes\n(patch, navigate)\nUse for loading data based on route\ne.g., load user from params[\"id\"]",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 83,
      "containerId": "concept-3",
      "originalText": "handle_params/3\nRuns after mount AND on URL changes\n(patch, navigate)\nUse for loading data based on route\ne.g., load user from params[\"id\"]",
      "lineHeight": 1.25
    },
    {
      "id": "concept-4",
      "type": "rectangle",
      "x": 420,
      "y": 680,
      "width": 440,
      "height": 160,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
