    {
      "id": "concept-4-text",
      "type": "text",
      "x": 120,
      "y": 1100,
      "width": 310,
      "height": 120,
      "strokeColor": "#1e1e1e",
      "text": "⚠️ Lifecycle hooks\non_mount/1 - runs before mount\nattach_hook/4 - intercept events\n\nUse for:\n- Auth checks\n- Shared setup\n- Cross-cutting concerns",
      "fontSize": 16,
      "fontFamily": "Virgil",
      "createdAt": "2026-03-03T20:14:26.689Z",
      "updatedAt": "2026-03-03T20:14:26.689Z",
      "version": 2,
      "versionNonce": 1904465588,
      "index": "at",
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "backgroundColor": "transparent",
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1772569275579,
      "link": null,
      "locked": false,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⚠️ Lifecycle hooks\non_mount/1 - runs before mount\nattach_hook/4 - intercept events\n\nUse for:\n- Auth checks\n- Shared setup\n- Cross-cutting concerns",
      "autoResize": true,
      "lineHeight": 0.9375
    },
    {
      "id": "concept-5",
      "type": "rectangle",
