      "locked": false
    },
    {
      "id": "concept-5-text",
      "type": "text",
      "x": 430,
      "y": 895,
      "width": 420,
      "height": 130,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1234567924,
      "version": 1,
      "versionNonce": 1234567924,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709494800000,
      "link": null,
      "locked": false,
      "text": "Process Messages & PubSub\nhandle_info receives messages:\n- Process.send_after (timers)\n- Phoenix.PubSub broadcasts\n- GenServer messages\nPattern: subscribe in mount,\nhandle broadcasts in handle_info",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 123,
      "containerId": "concept-5",
      "originalText": "Process Messages & PubSub\nhandle_info receives messages:\n- Process.send_after (timers)\n- Phoenix.PubSub broadcasts\n- GenServer messages\nPattern: subscribe in mount,\nhandle broadcasts in handle_info",
      "lineHeight": 1.25
    },
    {
      "id": "concept-6",
      "type": "rectangle",
      "x": 420,
      "y": 1080,
      "width": 440,
      "height": 140,
