      "link": null,
      "locked": false,
      "text": "Testing Tips\nuse render_* functions from\nPhoenix.LiveViewTest\nTest outcomes, not implementation\nVerify element presence with has_element?",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 73,
      "containerId": "concept-7",
      "originalText": "Testing Tips\nuse render_* functions from\nPhoenix.LiveViewTest\nTest outcomes, not implementation\nVerify element presence with has_element?",
      "lineHeight": 1.25
    },
