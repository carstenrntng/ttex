      "isDeleted": false,
      "boundElements": [{"type": "text", "id": "concept-4-text"}],
      "updated": 1709494800000,
      "link": null,
      "locked": false
    },
    {
      "id": "concept-4-text",
      "type": "text",
      "x": 430,
      "y": 705,
      "width": 420,
      "height": 110,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1234567922,
      "version": 1,
      "versionNonce": 1234567922,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709494800000,
      "link": null,
      "locked": false,
      "text": "Every assign update triggers render/1\nassign(socket, :key, value)\nUse streams for large collections:\nstream(socket, :items, items)\nAvoids re-rendering entire list!",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 103,
      "containerId": "concept-4",
      "originalText": "Every assign update triggers render/1\nassign(socket, :key, value)\nUse streams for large collections:\nstream(socket, :items, items)\nAvoids re-rendering entire list!",
      "lineHeight": 1.25
    },
    {
      "id": "concept-5",
      "type": "rectangle",
