      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {"type": 3},
      "seed": 1234567917,
      "version": 1,
      "versionNonce": 1234567917,
      "isDeleted": false,
      "boundElements": [{"type": "text", "id": "concept-2-text"}],
      "updated": 1709494800000,
      "link": null,
      "locked": false
    },
    {
      "id": "concept-2-text",
      "type": "text",
      "x": 430,
      "y": 360,
      "width": 420,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1234567918,
      "version": 1,
      "versionNonce": 1234567918,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709494800000,
      "link": null,
      "locked": false,
      "text": "mount/3 runs TWICE\n1st: Static render (fast HTML response)\n2nd: Live connection (full state setup)\nPattern: if connected?(socket), do: ...\nAvoid duplicate work!",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 93,
      "containerId": "concept-2",
      "originalText": "mount/3 runs TWICE\n1st: Static render (fast HTML response)\n2nd: Live connection (full state setup)\nPattern: if connected?(socket), do: ...\nAvoid duplicate work!",
      "lineHeight": 1.25
    },
    {
      "id": "concept-3",
      "type": "rectangle",
