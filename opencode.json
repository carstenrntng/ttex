{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "excalidraw": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "docker run -i --rm -v \"$(pwd):/app/workspace\" -e EXPRESS_SERVER_URL=http://host.docker.internal:3000 -e ENABLE_CANVAS_SYNC=true -e EXCALIDRAW_EXPORT_DIR=/app/workspace ghcr.io/yctimlin/mcp_excalidraw:latest"
      ],
      "enabled": true
    }
  }
}