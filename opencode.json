{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "*.env": "deny",
      "awk *": "deny",
      "cat *": "deny",
      "curl -s http://localhost:3000/*": "allow",
      "docker inspect *": "allow",
      "docker logs *": "allow",
      "docker ps *": "allow",
      "echo *": "deny",
      "find *": "deny",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git push": "deny",
      "git status *": "allow",
      "glob": "allow",
      "grep *": "deny",
      "grep": "allow",
      "head *": "deny",
      "list": "allow",
      "ls *": "allow",
      "lsp": "allow",
      "mix credo": "allow",
      "mix dialyzer": "allow",
      "mix format": "allow",
      "mix test*": "allow",
      "mkdir *": "allow",
      "rg *": "deny",
      "sed *": "deny",
      "tail *": "deny",
      "yamllint *": "allow",
    }
  },
  "mcp": {
    "excalidraw": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "docker run -i --rm -v \"$(pwd):/app/workspace\" -e EXPRESS_SERVER_URL=http://host.docker.internal:3000 -e ENABLE_CANVAS_SYNC=true -e EXCALIDRAW_EXPORT_DIR=/app/workspace ghcr.io/yctimlin/mcp_excalidraw:latest"
      ],
      "enabled": true
    },
    "tidewave": {
      "type": "remote",
      "url": "http://localhost:4000/tidewave/mcp",
      "enabled": true
    }
  }
}